{%- comment -%}
  Spotify Playlist Embed Section for Collection Pages
{%- endcomment -%}

{%- assign raw_identifier = collection.metafields.spotify.playlist_identifier.value | default: collection.metafields.spotify.playlist_identifier -%}

{%- comment -%} Fallback to section setting if metafield is blank {%- endcomment -%}
{%- if raw_identifier == blank -%}
  {%- assign raw_identifier = section.settings.fallback_playlist_identifier -%}
{%- endif -%}

{%- if raw_identifier != blank -%}
  {%- assign cleaned_identifier = raw_identifier | strip -%}
  {%- assign playlist_id = cleaned_identifier -%}

  {%- if cleaned_identifier contains 'spotify:playlist:' -%}
    {%- assign playlist_id = cleaned_identifier | replace: 'spotify:playlist:', '' -%}
  {%- elsif cleaned_identifier contains 'spotify.com/playlist/' -%}
    {%- assign playlist_id = cleaned_identifier | split: 'spotify.com/playlist/' | last | split: '?' | first | split: '/' | first -%}
  {%- elsif cleaned_identifier contains 'open.spotify.com/embed/playlist/' -%}
    {%- assign playlist_id = cleaned_identifier | split: 'open.spotify.com/embed/playlist/' | last | split: '?' | first | split: '/' | first -%}
  {%- endif -%}

  <div class="shopify-section-spotify-playlist color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding" id="shopify-section-spotify-playlist-{{ section.id }}">
    <div class="page-width">
      <div class="spotify-playlist-container {% if section.settings.center_align %}spotify-playlist-center{% endif %}">
        {%- if section.settings.heading != blank -%}
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        
        {%- if section.settings.description != blank -%}
          <div class="spotify-playlist-description rte">{{ section.settings.description }}</div>
        {%- endif -%}

        <div class="spotify-playlist-embed-wrapper">
          <iframe 
            src="https://open.spotify.com/embed/playlist/{{ playlist_id | escape }}?utm_source=generator{% if section.settings.theme_color == '0' or section.settings.theme_color == '1' %}&theme={{ section.settings.theme_color }}{% endif %}" 
            width="100%" 
            height="{{ section.settings.embed_height }}" 
            frameBorder="0" 
            allowfullscreen="" 
            allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" 
            loading="lazy"
            class="spotify-playlist-iframe"
          ></iframe>
        </div>
      </div>
    </div>
  </div>

  <style>
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    .spotify-playlist-container {
      max-width: {{ section.settings.max_width }}px;
      margin: 0 auto;
    }

    .spotify-playlist-center {
      text-align: center;
    }

    .spotify-playlist-description {
      margin-bottom: 2rem;
    }

    .spotify-playlist-embed-wrapper {
      width: 100%;
      border-radius: 12px;
      overflow: hidden;
      line-height: 0;
      box-shadow: {% if section.settings.enable_shadow %}0 8px 24px rgba(0,0,0,0.12){% else %}none{% endif %};
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .spotify-playlist-embed-wrapper:hover {
      {% if section.settings.enable_shadow %}
      transform: translateY(-2px);
      box-shadow: 0 12px 32px rgba(0,0,0,0.18);
      {% endif %}
    }

    .spotify-playlist-iframe {
      border-radius: 12px;
      border: none;
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Spotify Playlist Embed",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "This section displays the Spotify playlist defined in the collection's `spotify.playlist_identifier` metafield. If empty, the fallback playlist defined below is used."
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Inspired Playlist",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "description",
      "default": "<p>Listen to the tracks that inspired this collection.</p>",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "fallback_playlist_identifier",
      "label": "Fallback Playlist ID / URL",
      "info": "Used if the collection metafield is empty. Accepts URL, URI or playlist ID."
    },
    {
      "type": "select",
      "id": "embed_height",
      "options": [
        {
          "value": "152",
          "label": "Compact (152px)"
        },
        {
          "value": "352",
          "label": "Medium (352px)"
        },
        {
          "value": "500",
          "label": "Large (500px)"
        }
      ],
      "default": "352",
      "label": "Embed player height"
    },
    {
      "type": "select",
      "id": "theme_color",
      "options": [
        {
          "value": "default",
          "label": "Dynamic (Spotify Default)"
        },
        {
          "value": "0",
          "label": "Dark Theme"
        }
      ],
      "default": "default",
      "label": "Embed Theme Color"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 400,
      "max": 1200,
      "step": 50,
      "default": 800,
      "unit": "px",
      "label": "Maximum container width"
    },
    {
      "type": "checkbox",
      "id": "center_align",
      "default": true,
      "label": "Center align text content"
    },
    {
      "type": "checkbox",
      "id": "enable_shadow",
      "default": true,
      "label": "Show depth shadow"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Padding top"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 36,
      "label": "Padding bottom"
    }
  ],
  "presets": [
    {
      "name": "Spotify Playlist Embed"
    }
  ]
}
{% endschema %}
